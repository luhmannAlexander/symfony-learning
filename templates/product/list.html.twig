{% extends 'base.html.twig' %}

{% block title %}Hello ProductController!{% endblock %}

{% block main %}
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Preis</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.name }}</td>
                <td>{{ product.price }}</td>
                <td><a href="{{ path('product_show',{'id':product.id}) }}" class="btn btn-warning">Show</a></td>
                <td><a href="{{ path('product_edit',{'id':product.id}) }}" class="btn btn-secondary">edit</a></td>
                <td><a href="{{ path('product_update',{'id':product.id}) }}" class="btn btn-primary">Update</a></td>
                <td><a href="{{ path('product_delete',{'id':product.id}) }}" class="btn btn-danger">Delete</a></td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th>Total</th>
            <td>{{ total }}</td>
        </tr>
    </tfoot>
</table>
{% endblock %}
