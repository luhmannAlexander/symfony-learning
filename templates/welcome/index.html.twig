{% extends 'base.html.twig' %}

{% block title %}Hello WelcomeController!{% endblock %}

{% block main %}
    <h1>Hello {{ username }}! ✅</h1>
    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/var/www/html/symfony-learning/my_project_directory/src/Controller/WelcomeController.php</code></li>
        <li>Your template at <code>/var/www/html/symfony-learning/my_project_directory/templates/welcome/index.html.twig</code></li>
    </ul>
    {% for i in 1..10 %}
        <p>{{ i }}</p>
    {% endfor %}
{% endblock %}
